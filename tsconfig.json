{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "rootDir": "src", "outDir": "dist",
    "skipLibCheck": true, "declaration": true
  },
  "include": ["src/**/*.ts"]
}
