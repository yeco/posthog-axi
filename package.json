{
  "name": "posthog-axi",
  "version": "0.1.0",
  "description": "My PostHog CLI for AI agents and scripts: every operation in PostHog's OpenAPI schema, HogQL queries, feature flags, experiments and surveys, with compact TOON output.",
  "keywords": [
    "posthog",
    "posthog-api",
    "posthog-cli",
    "cli",
    "ai-agents",
    "agent-tools",
    "openapi",
    "hogql",
    "feature-flags",
    "experiments",
    "product-analytics",
    "toon"
  ],
  "type": "module",
  "bin": {
    "posthog-axi": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeco/posthog-axi.git"
  },
  "homepage": "https://www.npmjs.com/package/posthog-axi",
  "bugs": {
    "url": "https://github.com/yeco/posthog-axi/issues"
  },
  "author": "Jasson Cascante",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "schema:check": "npm run build && node scripts/schema.mjs check",
    "schema:update": "npm run build && node scripts/schema.mjs update",
    "prepublishOnly": "npm run build && npm test && npm run schema:check",
    "pack:check": "npm run build && node scripts/pack-check.mjs"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
